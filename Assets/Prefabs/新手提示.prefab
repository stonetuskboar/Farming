    m_Bottom: 0
  RectTransformByVisibleJudge: {fileID: 6946866706037312452}
  layouGroup: {fileID: 7568326383102034271}
  text: {fileID: 3087547935329846038}
  image: {fileID: 4921809651043268074}
  FarmCat: {fileID: 21300000, guid: 4ca8c5abbf3de3f4ea75115b687d5027, type: 3}
  PointCat: {fileID: 21300000, guid: 40f6ce04beb3fbd40aae0d49135e6054, type: 3}
  DeclineButton: {fileID: 8374763564370134091}
  ConfirmButton: {fileID: 863629084927679296}
  BeginnerTipList:
  - str: "\u8FD9\u91CC\u662F\u65B0\u624B\u6559\u7A0B\uFF0C\u70B9\u51FB\u662F\u4EE5\u7EE7\u7EED\uFF0C\u70B9\u51FB\u5426\u4EE5\u8DF3\u8FC7\u6559\u7A0B\uFF01"
    position: {x: 0, y: 0}
    Anchor: {x: 0.5, y: 0.5}
    cat: 1
    IsLeft: 1
  - str: "\u8FD9\u91CC\u662F\u4F60\u7684\u5DE5\u5177\u680F\uFF0C\u7528\u5B83\u4EEC\u8FDB\u884C\u8015\u79CD\uFF01\u5C06\u6307\u9488\u653E\u5728\u5DE5\u5177\u4E0A\uFF0C\u53EF\u4EE5\u67E5\u770B\u5DE5\u5177\u7684\u8BE6\u7EC6\u4FE1\u606F\u3002\u70B9\u51FB\u5DE5\u5177\uFF0C\u53EF\u4EE5\u5207\u6362\u5230\u8FD9\u4E2A\u5DE5\u5177\u3002"
    position: {x: -609, y: 56}
    Anchor: {x: 0.5, y: 0}
    cat: 0
    IsLeft: 1
  - str: "\u8FD9\u91CC\u662F\u9F20\u6807\uFF0C\u7528\u5B83\u907F\u514D\u8BEF\u89E6\u3002\u6309\u4F4F\u5E76\u62D6\u52A8\uFF0C\u53EF\u4EE5\u79FB\u52A8\u753B\u9762\u3002\u5982\u679C\u662F\u624B\u673A\uFF0C\u53CC\u6307\u53EF\u4EE5\u7F29\u653E\u753B\u9762\u8303\u56F4\u3002\u5982\u679C\u662F\u7535\u8111\uFF0C\u8FD8\u53EF\u4EE5\u7528wasd\u79FB\u52A8\uFF0C\u6309\u4F4Fshift+\u6EDA\u8F6E\u7F29\u653E\uFF01"
    position: {x: -717, y: 71}
    Anchor: {x: 0.5, y: 0}
    cat: 0
    IsLeft: 1
  - str: "\u8FD9\u91CC\u662F\u7CBE\u529B\u6761\uFF0C\u4F7F\u7528\u5DE5\u5177\u4F1A\u6D88\u8017\u7CBE\u529B\uFF0C\u6BCF\u4E2A\u6708\u53EA\u6709200\u70B9\u7CBE\u529B\uFF0C\u7528\u5B8C\u540E\uFF0C\u53EA\u80FD\u7B49\u5230\u4E0B\u4E2A\u6708\u6062\u590D\u4E86\uFF01"
    position: {x: -532, y: 159}
    Anchor: {x: 0.5, y: 0}
    cat: 0
    IsLeft: 1
  - str: "\u70B9\u51FB\u8FD9\u91CC\u53EF\u4EE5\u8FDB\u5165\u4E0B\u4E2A\u6708\uFF08\u73B0\u5728\u5148\u4E0D\u8981\u70B9\uFF01\uFF09\uFF0C\u7CBE\u529B\u4F1A\u6062\u590D\u5230200\uFF0C\u519C\u4F5C\u7269\u4F1A\u751F\u957F\u3002"
    position: {x: -940, y: -15}
    Anchor: {x: 1, y: 0}
    cat: 0
    IsLeft: 0
  - str: "\u8FD9\u91CC\u662F\u5546\u5E97\uFF01\u8FD9\u662F\u6700\u91CD\u8981\u7684\u90E8\u5206\u3002\u5728\u8FD9\u91CC\u8D2D\u4E70\u79CD\u5B50\uFF0C\u64AD\u6492\u751F\u957F\u6210\u719F\u540E\uFF0C\u6536\u83B7\u7684\u4F5C\u7269\u4E5F\u5728\u5546\u5E97\u91CC\u552E\u5356\u3002\u4F60\u8FD8\u53EF\u4EE5\u5728\u5546\u5E97\u5347\u7EA7\u5DE5\u5177\u3002"
    position: {x: -945, y: -407}
    Anchor: {x: 1, y: 1}
    cat: 0
    IsLeft: 0
  - str: "\u8FD9\u91CC\u662F\u65E5\u5386\uFF0C\u4F60\u53EF\u4EE5\u5728\u4E00\u6708\u5230\u4E5D\u6708\u8015\u4F5C\uFF0C\u5230\u4E86\u51AC\u5929\uFF0C\u4F60\u5C31\u8981\u5411\u54AA\u795E\u8FDB\u8D21\u3002\u7B2C\u4E00\u5E74\u9700\u8981800\u5757\u3002"
    position: {x: -1012, y: -300}
    Anchor: {x: 1, y: 1}
    cat: 0
    IsLeft: 0
  - str: "\u4F60\u7684\u521D\u671F\u4EFB\u52A1\u662F\u7528\u9504\u5934\u548C\u65A7\u5934\u5F00\u8352\uFF0C\u65A7\u5934\u53EF\u4EE5\u780D\u6811\uFF0C\u9504\u5934\u53EF\u4EE5\u6E05\u9664\u6742\u8349\u548C\u77F3\u5934\u3002\u6389\u843D\u7269\u4E5F\u53EF\u4EE5\u5728\u5546\u5E97\u5356\u6389\u6362\u94B1\u3002\u8FD9\u662F\u4F60\u521D\u671F\u7684\u6536\u5165\u6765\u6E90\uFF01"
    position: {x: -371, y: 71}
    Anchor: {x: 0.5, y: 0}
    cat: 0
    IsLeft: 1
  - str: "\u800C\u5728\u4E4B\u540E\uFF0C\u4F60\u9700\u8981\u7528\u9504\u5934\u5F00\u8352\uFF0C\u79CD\u4E0B\u79CD\u5B50\u540E\uFF0C\u7ED9\u5B83\u6D47\u6C34\uFF0C\u8FD9\u6837\uFF0C\u79CD\u5B50\u624D\u80FD\u751F\u957F\u6210\u719F\u3002"
    position: {x: -608, y: 71}
    Anchor: {x: 0.5, y: 0}
    cat: 0
    IsLeft: 1
  - str: "\u4E0D\u540C\u7684\u79CD\u5B50\u6709\u4E0D\u540C\u7684\u751F\u957F\u5B63\u8282\uFF0C\u4E0D\u5728\u8FD9\u4E2A\u5B63\u8282\uFF0C\u79CD\u5B50\u5C31\u4E0D\u80FD\u79CD\u690D\u548C\u751F\u957F\u3002\u79CD\u5B50\u79CD\u4E0B\u9700\u8981\u51E0\u4E2A\u6708\u65F6\u95F4\u751F\u957F\uFF0C\u5982\u679C\u8FC7\u4E86\u5BF9\u5E94\u7684\u5B63\u8282\uFF0C\u79CD\u4E0B\u7684\u79CD\u5B50\u8FD8\u6CA1\u6210\u719F\uFF0C\u5C31\u4F1A\u67AF\u840E\uFF0C\u5C0F\u5FC3\u5662\uFF01"
    position: {x: -136, y: 71}
    Anchor: {x: 0.5, y: 0}
    cat: 0
    IsLeft: 1
  - str: "\u6700\u540E\uFF0C\u6536\u83B7\u7684\u4F5C\u7269\u8BB0\u5F97\u5728\u5546\u5E97\u51FA\u552E\uFF0C\u4ECA\u5E74\u9700\u8981\u8D5A\u5230800\u5757\uFF0C\u52A0\u6CB9\u5662\uFF01"
    position: {x: -945, y: -407}
    Anchor: {x: 1, y: 1}
    cat: 1
    IsLeft: 0
  HasStartBeginnerTip: 0
